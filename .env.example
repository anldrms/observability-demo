# Observability Demo Platform - Cloud-Ready Configuration

# Graylog Configuration (REQUIRED)
# Generate secret: openssl rand -hex 32
GRAYLOG_PASSWORD_SECRET=
# SHA256 of admin password: echo -n 'yourpassword' | shasum -a 256 | awk '{print $1}'
GRAYLOG_ROOT_PASSWORD_SHA2=

# MongoDB Configuration
MONGO_USER=admin
MONGO_PASSWORD=admin

# Application Configuration
NODE_ENV=production
APP_PORT=3000

# Service Ports (customize for cloud deployment)
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
GRAYLOG_PORT=9000

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Public URLs for cloud deployment
# Replace these with your actual public URLs when deploying to cloud
# Examples:
#   - Fly.io: https://yourapp.fly.dev
#   - Railway: https://yourapp.railway.app
#   - Render: https://yourapp.onrender.com
#   - DigitalOcean: https://yourapp.ondigitalocean.app
PUBLIC_GRAFANA_URL=http://localhost:3001
PUBLIC_PROMETHEUS_URL=http://localhost:9090
PUBLIC_GRAYLOG_URL=http://localhost:9000
GRAYLOG_EXTERNAL_URI=http://localhost:9000/
GRAFANA_ROOT_URL=http://localhost:3001

# For cloud deployment, update to:
# PUBLIC_GRAFANA_URL=https://grafana-yourapp.fly.dev
# PUBLIC_PROMETHEUS_URL=https://prometheus-yourapp.fly.dev
# PUBLIC_GRAYLOG_URL=https://graylog-yourapp.fly.dev
# GRAYLOG_EXTERNAL_URI=https://graylog-yourapp.fly.dev/
# GRAFANA_ROOT_URL=https://grafana-yourapp.fly.dev
